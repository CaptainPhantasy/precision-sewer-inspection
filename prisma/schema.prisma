generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model ContactSubmission {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String?
  message           String
  serviceType       String?  @default("general")
  source            String?  @default("website")
  status            String   @default("new")
  // Structured booking fields
  propertyAddress   String?
  propertyCity      String?
  propertyState     String?
  propertyZip       String?
  occupancy         String?
  propertyAccess    String?
  cleanoutLocation  String?
  referrerName      String?
  buyersAgent       String?
  listingAgent      String?
  howHeardAboutUs   String?
  directions        String?
  appointmentDate   String?
  appointmentTime   String?
  promoCode         String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  checkoutStartedAt DateTime?
  abandonedAt       DateTime?
  recoveryEmailSentAt DateTime?
  recoveredAt       DateTime?
  // Payment tracking
  stripeSessionId   String?
  amountPaid        Float?
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ChatConversation {
  id        String   @id @default(cuid())
  sessionId String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  passwordHash     String
  name             String
  phone            String?
  role             UserRole     @default(TECHNICIAN)
  isActive         Boolean      @default(true)
  certifications   String[]
  profilePhotoPath String?
  profilePhotoUrl  String?
  bio              String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  inspections      Inspection[]
  assignedJobs     Job[]        @relation("AssignedTechnician")
  sessions         Session[]
  sentMessages     Message[]    @relation("SentMessages")
  conversations    ConversationParticipant[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id              String      @id @default(cuid())
  jobNumber       String      @unique
  clientName      String
  clientEmail     String
  clientPhone     String?
  clientRole      ClientRole  @default(HOMEOWNER)
  propertyAddress String
  propertyCity    String      @default("Indianapolis")
  propertyState   String      @default("IN")
  propertyZip     String
  propertyLat     Float?
  propertyLng     Float?
  scheduledDate   DateTime
  scheduledTime   String?
  accessType      AccessType  @default(CLEANOUT)
  hasCrawlSpace   Boolean     @default(false)
  specialNotes    String?
  basePrice       Float       @default(200)
  accessFee       Float       @default(0)
  totalPrice      Float       @default(200)
  technicianId    String?
  status          JobStatus   @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  inspection      Inspection?
  technician      User?       @relation("AssignedTechnician", fields: [technicianId], references: [id])
}

model Inspection {
  id                  String            @id @default(cuid())
  inspectionNumber    String            @unique
  jobId               String            @unique
  technicianId        String
  currentStage        InspectionStage   @default(ACCEPTED)
  confirmedClientName String?
  confirmedAddress    String?
  homeAge             String?
  pipeMaterial        PipeMaterial?
  knownIssues         String?
  backupHistory       String?
  recentWork          String?
  specialInstructions String?
  overallCondition    ConditionRating?
  rootIntrusion       Json?
  cracks              Json?
  bellies             Json?
  offsetJoints        Json?
  blockages           Json?
  pipeConditionRating Int?
  connectionToMain    String?
  recommendations     String?
  urgencyLevel        UrgencyLevel?
  startedAt           DateTime?
  arrivedAt           DateTime?
  inspectionStartedAt DateTime?
  inspectionEndedAt   DateTime?
  completedAt         DateTime?
  inspectionDuration  Int?
  status              InspectionStatus  @default(IN_PROGRESS)
  reviewedBy          String?
  reviewedAt          DateTime?
  reviewNotes         String?
  rejectedStage       InspectionStage?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  clientSignature     ClientSignature?
  deliveryToken       DeliveryToken?
  generatedReport     GeneratedReport?
  job                 Job               @relation(fields: [jobId], references: [id])
  technician          User              @relation(fields: [technicianId], references: [id])
  photos              InspectionPhoto[]
  locationLogs        LocationLog[]
  videoAttachment     VideoAttachment?
  voiceRecordings     VoiceRecording[]
  extendedMeasurements Json?             // { totalFootage, depthAtFindings, diameterTransitions, cameraDirection, flowDirection, equipmentUsed }
}

model LocationLog {
  id               String            @id @default(cuid())
  inspectionId     String
  latitude         Float
  longitude        Float
  accuracy         Float?
  eventType        LocationEventType
  timestamp        DateTime          @default(now())
  isOverride       Boolean           @default(false)
  overrideReason   String?
  overridePhotoUrl String?
  inspection       Inspection        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model VoiceRecording {
  id             String           @id @default(cuid())
  inspectionId   String
  audioFileUrl   String?
  audioCloudPath String?
  transcription  String?
  section        RecordingSection
  duration       Int?
  isProcessed    Boolean          @default(false)
  processedAt    DateTime?
  createdAt      DateTime         @default(now())
  inspection     Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model InspectionPhoto {
  id           String     @id @default(cuid())
  inspectionId String
  cloudPath    String
  publicUrl    String?
  caption      String?
  photoType    PhotoType
  defectType   String?
  timestamp    Float?
  createdAt    DateTime   @default(now())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model VideoAttachment {
  id                String         @id @default(cuid())
  inspectionId      String         @unique
  cloudPath         String
  publicUrl         String?
  fileName          String
  fileSize          Int
  duration          Int?
  mimeType          String         @default("video/mp4")
  checksum          String?
  uploadStatus      UploadStatus   @default(PENDING)
  uploadProgress    Int            @default(0)
  uploadedAt        DateTime?
  uploadId          String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  highlightDuration Int?
  highlightReelPath String?
  highlightReelUrl  String?
  inspection        Inspection     @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  chapters          VideoChapter[]
}

model VideoChapter {
  id                 String           @id @default(cuid())
  videoId            String
  timestamp          Int
  endTimestamp       Int?
  title              String
  description        String?
  chapterType        ChapterType      @default(FINDING)
  severity           FindingSeverity?
  includeInHighlight Boolean          @default(true)
  thumbnailPath      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  video              VideoAttachment  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model ClientSignature {
  id            String     @id @default(cuid())
  inspectionId  String     @unique
  signatureData String
  cloudPath     String?
  signerName    String
  signerRole    ClientRole
  latitude      Float?
  longitude     Float?
  signedAt      DateTime   @default(now())
  inspection    Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model GeneratedReport {
  id                    String     @id @default(cuid())
  inspectionId          String     @unique
  adminReportCloudPath  String?
  adminReportUrl        String?
  clientReportCloudPath String?
  clientReportUrl       String?
  plainLanguageSummary  String?
  estimatedRepairCost   String?
  generatedAt           DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  inspection            Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model DeliveryToken {
  id               String     @id @default(cuid())
  inspectionId     String     @unique
  token            String     @unique
  clientEmail      String
  issuedAt         DateTime   @default(now())
  displayExpiresAt DateTime
  actualExpiresAt  DateTime
  downloadLimit    Int        @default(3)
  downloadsUsed    Int        @default(0)
  firstDownloadIp  String?
  firstDownloadAt  DateTime?
  emailVerified    Boolean    @default(false)
  accessLogs       Json[]     @default([])
  sharedWith       Json[]     @default([])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  inspection       Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model ClientTrackingToken {
  id          String   @id @default(cuid())
  jobId       String   @unique
  token       String   @unique
  clientEmail String
  smsOptIn    Boolean  @default(false)
  clientPhone String?
  createdAt   DateTime @default(now())
}

model Conversation {
  id            String                    @id @default(cuid())
  title         String?
  isGroup       Boolean                   @default(false)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  messages      Message[]
  participants  ConversationParticipant[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

enum UserRole {
  TECHNICIAN
  MANAGER
  ADMIN
  OWNER
  SUPER_ADMIN
}

model LeadCapture {
  id              String   @id @default(cuid())
  sessionToken    String   @unique
  email           String?
  name            String?
  phone           String?
  address         String?
  city            String?
  state           String?
  zip             String?
  source          String?  @default("website")
  pageUrl         String?
  converted       Boolean  @default(false)
  notificationSent Boolean @default(false)
  lastActivityAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([notificationSent, lastActivityAt])
}

model SiteVisit {
  id            String   @id @default(cuid())
  sessionId     String
  pageUrl       String
  pageTitle     String?
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  deviceType    String?  // mobile, tablet, desktop
  browser       String?
  os            String?
  screenWidth   Int?
  screenHeight  Int?
  language      String?
  country       String?
  city          String?
  timeOnPage    Int?     // seconds
  scrollDepth   Int?     // percentage 0-100
  isEntryPage   Boolean  @default(false)
  isExitPage    Boolean  @default(false)
  visitedAt     DateTime @default(now())

  @@index([sessionId])
  @@index([visitedAt])
  @@index([pageUrl])
}

model SiteEvent {
  id          String   @id @default(cuid())
  sessionId   String
  eventType   String   // click, form_focus, form_abandon, cta_click, phone_click, chat_open, scroll_milestone
  eventTarget String?  // button text, element id, form name
  pageUrl     String?
  metadata    String?  // JSON string for extra data
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
}

enum ClientRole {
  HOMEOWNER
  BUYER
  SELLER
  REALTOR
  PROPERTY_MANAGER
  OTHER
}

enum AccessType {
  CLEANOUT
  ROOF_VENT
  TOILET_PULL
  UNKNOWN
}

enum JobStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ON_SITE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionStage {
  ACCEPTED
  EN_ROUTE
  ARRIVED
  PRE_INSPECTION
  INSPECTING
  POST_INSPECTION
  VIDEO_ATTACH
  CLIENT_SIGNOFF
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DELIVERED
}

enum PipeMaterial {
  CAST_IRON
  CLAY
  PVC
  ABS
  ORANGEBURG
  CONCRETE
  HDPE
  UNKNOWN
}

enum ConditionRating {
  GOOD
  FAIR
  NEEDS_ATTENTION
  CRITICAL
}

enum UrgencyLevel {
  NONE
  MONITOR
  SOON
  IMMEDIATE
}

enum InspectionStatus {
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DELIVERED
}

enum LocationEventType {
  EN_ROUTE
  ARRIVED
  INSPECTION_START
  INSPECTION_END
  CHECKOUT
  SIGNATURE
}

enum RecordingSection {
  PRE_INSPECTION
  DURING_INSPECTION
  POST_INSPECTION
  GENERAL_NOTES
}

enum PhotoType {
  PROPERTY_FRONT
  ACCESS_POINT
  DEFECT
  GENERAL
  BEFORE
  AFTER
}

enum ChapterType {
  INTRO
  FINDING
  DEFECT
  REPAIR_NEEDED
  OBSERVATION
  CONCLUSION
}

enum FindingSeverity {
  INFO
  MINOR
  MODERATE
  MAJOR
  CRITICAL
}

enum UploadStatus {
  PENDING
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}
